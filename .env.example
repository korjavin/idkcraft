# ===========================================
# idkcraft — compose stack env vars.
# Set these as the Portainer stack env vars (Portainer watches the deploy
# branch). Every var has a default in docker-compose.yml; only secrets need
# a real value. Also used for local checks:
#   docker compose --env-file .env.example config -q
# ===========================================

# --- mc service image ---
# itzg/minecraft-server date tag; checked 2026-09-21 (current, ships Java 25).
MC_IMAGE_TAG=2026.9.1
MC_CONTAINER_NAME=idkcraft-mc

# --- Minecraft version pin ---
# MC_VERSION=26.1.2, chosen 2026-09-21: the newest Paper version that BOTH
# Geyser and mineflayer support. mineflayer (minecraft-data @latest) speaks
# PC protocol up to 26.1 (node -e "console.log(require('minecraft-data').
# supportedVersions.pc)"); Geyser emulates a 26.2 Java client and supports
# servers >= 1.20.5, with ViaVersion bridging the <26.2 gap (see PLUGINS).
# Re-check: https://geysermc.org/wiki/geyser/supported-versions/
MC_VERSION=26.1.2

# --- Server resources (2-5 players + 1 bot) ---
MC_INIT_MEMORY=512M
MC_MAX_MEMORY=2G
# 2G max is the floor for Paper+Geyser+ViaVersion; 1G is an experiment
# the owner may try via the stack env and watch for OOM/GC lag.
MC_MEM_LIMIT=3g

# --- Ports, published directly (no Traefik — raw TCP/UDP) ---
MC_JAVA_PORT=25565
MC_BEDROCK_PORT=19132

# --- Data (bind-mount into the mc container) ---
MC_DATA_PATH=./data

# --- Auth: offline mode + whitelist (the bot has no Microsoft account) ---
# WHITELIST holds the bot's OFFLINE uuid: name lookups resolve to online
# UUIDs, which never match in offline mode. Offline UUID of IdkBot; if
# BOT_USERNAME changes, recompute:
# python3 -c 'import uuid,hashlib;print(uuid.UUID(bytes=hashlib.md5(b"OfflinePlayer:IdkBot").digest(),version=3))'
WHITELIST=3d1f4b94-9298-3ba3-af2d-3f73ce56138f
# Bedrock/Switch players: do NOT put them in WHITELIST (dotted Floodgate
# names fail startup resolution and crash-loop the container). After the
# stack is up, run: docker compose exec mc rcon-cli whitelist add .Gamertag
# (Floodgate resolves the dotted name) — or add their Floodgate UUID from
# the server log. (Floodgate prefix ".", spaces -> _, e.g. .My_Gamer.)
# Comma-separated Java-profile names with operator status, e.g. OPS=Steve,Alex
OPS=
MC_DIFFICULTY=easy

# --- bot service (image built from ./bot by CI; sibling bead owns bot/**) ---
BOT_CONTAINER_NAME=idkcraft-bot
BOT_USERNAME=IdkBot
# Player to follow; empty = nearest player.
BOT_FOLLOW=
# Nobody-online grace (ms) before the bot quits and re-polls; 0 disables (always on).
BOT_LEAVE_AFTER_MS=60000
BRAIN_TICK_MS=1000

# --- Brain (per-tick ask retired in idkcraft-vhlb.5; laya sidecar dropped in idkcraft-jlda.6) ---
# Retired: ignored by the bot (logs 'BRAIN_URL ignored'); only the manual
# chat 'brain laya' reads it. Empty = stub: the FSM decides every tick.
BRAIN_URL=
# Tune to ~3x measured p50 (bring-up bead measures on prod).
BRAIN_TIMEOUT_MS=3000

# --- baritone worker (image built from ./baritone by CI; idkcraft-jlda) ---
BARITONE_CONTAINER_NAME=idkcraft-baritone
# Measured 1.9 GiB RSS while pathing; with no stored account the container
# sleeps at ~0 RAM. The auth volume name is FIXED in docker-compose.yml
# (idkcraft-baritone-auth) so the one-time login survives redeploys.
BARITONE_MEM_LIMIT=2500m
# Worker pilot fish, head-owned bridge: empty = off (zero behaviour diff).
# Set to the worker's profile name after the one-time login (baritone/README.md).
WORKER_NAME=
WORKER_HOST=baritone
WORKER_PORT=7777

# --- JEV brain secret ---
# Whenever set, enables the JEV stall-point plan() (paid calls at watchdog
# stalls); BRAIN_URL does not gate it. From stash: ~/stash/kv get
# secrets/jev-api-key; set as Portainer stack env var, never commit.
TYPESAFE_API_KEY=

# --- LLM stall-point planner (idkcraft-vhlb.2), opt-in ---
# Set ANTHROPIC_API_KEY to let a text LLM (Messages API) answer the goal
# watchdog's plan() at stall points only, never per tick. Empty = today's
# behaviour (JEV planner when TYPESAFE_API_KEY is set, else none). From
# stash: secrets/minecraft/anthropic-api-key; Portainer env var, never commit.
ANTHROPIC_API_KEY=
# llm | jev; empty = llm when ANTHROPIC_API_KEY is set, else jev.
PLANNER=
# Empty = claude-haiku-5-5.
LLM_MODEL=

# --- Goal watchdog (idkcraft-vmzq.21): fast JEV rounds on a flat goal ---
# Flat window (ms) before a round fires; 0 = off (shipped 15/45-min ladder).
GOAL_WATCHDOG_MS=60000
# Bounded commitment window (ms) for a watchdog choice.
GOAL_COMMIT_MS=120000
# Consecutive flat rounds before park (owner online) / plan-B (offline).
GOAL_WATCHDOG_MAX_ROUNDS=6
# Travel-grace floor (ms): one castlefetch leg-start reset per window.
GOAL_TRAVEL_GRACE_MS=90000
# Plan-B goal-switch duration (ms) when nobody is online.
GOAL_PLANB_SWITCH_MS=450000

# External docker network of the host monitoring stack (vmagent scrapes
# bot :9464 /metrics over it). Must exist before deploy.
MONITORING_NETWORK=monitoring_internal
