# ===========================================
# idkcraft — compose stack env vars.
# Set these as the Portainer stack env vars (Portainer watches the deploy
# branch). Every var has a default in docker-compose.yml; only secrets need
# a real value. Also used for local checks:
#   docker compose --env-file .env.example config -q
# ===========================================

# --- mc service image ---
# itzg/minecraft-server date tag; checked 2026-09-21 (current, ships Java 25).
MC_IMAGE_TAG=2026.9.1
MC_CONTAINER_NAME=idkcraft-mc

# --- Minecraft version pin ---
# MC_VERSION=26.1.2, chosen 2026-09-21: the newest Paper version that BOTH
# Geyser and mineflayer support. mineflayer (minecraft-data @latest) speaks
# PC protocol up to 26.1 (node -e "console.log(require('minecraft-data').
# supportedVersions.pc)"); Geyser emulates a 26.2 Java client and supports
# servers >= 1.20.5, with ViaVersion bridging the <26.2 gap (see PLUGINS).
# Re-check: https://geysermc.org/wiki/geyser/supported-versions/
MC_VERSION=26.1.2

# --- Server resources (2-5 players + 1 bot) ---
MC_MEMORY=4G
MC_MEM_LIMIT=6g

# --- Ports, published directly (no Traefik — raw TCP/UDP) ---
MC_JAVA_PORT=25565
MC_BEDROCK_PORT=19132

# --- Data (bind-mount into the mc container) ---
MC_DATA_PATH=./data

# --- Auth: offline mode + whitelist (the bot has no Microsoft account) ---
# WHITELIST holds the bot's OFFLINE uuid: name lookups resolve to online
# UUIDs, which never match in offline mode. Offline UUID of IdkBot; if
# BOT_USERNAME changes, recompute:
# python3 -c 'import uuid,hashlib;print(uuid.UUID(bytes=hashlib.md5(b"OfflinePlayer:IdkBot").digest(),version=3))'
WHITELIST=3d1f4b94-9298-3ba3-af2d-3f73ce56138f
# Bedrock/Switch players: do NOT put them in WHITELIST (dotted Floodgate
# names fail startup resolution and crash-loop the container). After the
# stack is up, run: docker compose exec mc rcon-cli whitelist add .Gamertag
# (Floodgate resolves the dotted name) — or add their Floodgate UUID from
# the server log. (Floodgate prefix ".", spaces -> _, e.g. .My_Gamer.)
# Comma-separated Java-profile names with operator status, e.g. OPS=Steve,Alex
OPS=
MC_DIFFICULTY=easy

# --- bot service (image built from ./bot by CI; sibling bead owns bot/**) ---
BOT_CONTAINER_NAME=idkcraft-bot
BOT_USERNAME=IdkBot
# Player to follow; empty = nearest player.
BOT_FOLLOW=
BRAIN_TICK_MS=1000

# --- laya sidecar (image built from ./laya by CI) ---
LAYA_CONTAINER_NAME=idkcraft-laya
# 3g default (was 2g): prod OOM-killed the sidecar under 2g at load.
LAYA_MEM_LIMIT=3g
LAYA_THREADS=4
# Compose default = sidecar (self-contained stack). The bot CODE default stays
# the JEV URL for tests/local dev. Switch back to JEV: set BRAIN_URL to the
# JEV endpoint (see bot/src/brain.js) + TYPESAFE_API_KEY below.
BRAIN_URL=http://laya:8000/v1/systemone
# Tune to ~3x measured p50 (bring-up bead measures on prod).
BRAIN_TIMEOUT_MS=3000

# --- JEV brain secret ---
# Used only when BRAIN_URL points at JEV; with the laya sidecar the key is
# ignored. From stash: ~/stash/kv get secrets/jev-api-key; set as Portainer
# stack env var, never commit.
TYPESAFE_API_KEY=
